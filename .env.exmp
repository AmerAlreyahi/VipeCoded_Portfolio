# Copy to .env.local (never commit real values). Full guide: docs/IMPLEMENTATION_PLAN.md

# Supabase (optional for local UI preview; required to serve production content)
# Dashboard -> Project Settings -> API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails allowed into /admin (must also be in the portfolio_admins table)
ADMIN_EMAILS=

# Resend contact form (required to deliver messages)
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM_EMAIL=

# Optional: GitHub project import (server-side only, never stored in the database)
GITHUB_USERNAME=
GITHUB_TOKEN=
